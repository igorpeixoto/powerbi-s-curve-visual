{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "$comment": "Pre-approved permissions for a Power BI custom visual (.pbiviz) repo. Rules are glob-matched; trailing ' *' allows arguments. Deliberately NOT pre-approved: 'pbiviz --install-cert' (touches the OS trust store — a user action, CLAUDE.md Hard Rule #11), 'pbi visual import-custom' (writes into a report's .pbip), and 'npm publish'.",
  "permissions": {
    "allow": [
      "Read(**)",
      "Edit(**)",

      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git grep *)",
      "Bash(git merge-base *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git branch *)",
      "Bash(git switch *)",
      "Bash(git checkout *)",
      "Bash(git merge *)",
      "Bash(git tag *)",
      "Bash(git stash *)",
      "Bash(git restore *)",
      "Bash(git mv *)",
      "Bash(git subtree *)",

      "Bash(ls *)",
      "Bash(dir *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(wc *)",
      "Bash(diff *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(pwd)",
      "Bash(echo *)",

      "Bash(awk *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh run watch *)",
      "Bash(gh repo view *)",

      "Bash(node *)",
      "Bash(npm --version)",
      "Bash(npm install)",
      "Bash(npm install *)",
      "Bash(npm ci)",
      "Bash(npm ls *)",
      "Bash(npm run *)",
      "Bash(npm audit *)",
      "Bash(npx tsc *)",
      "Bash(npx eslint *)",

      "Bash(pbiviz --version)",
      "Bash(pbiviz new *)",
      "Bash(pbiviz start *)",
      "Bash(pbiviz start)",
      "Bash(pbiviz package *)",
      "Bash(pbiviz package)",
      "Bash(pbiviz lint *)",
      "Bash(pbiviz info *)",

      "Bash(tasklist *)"
    ],
    "deny": [
      "Bash(pbiviz --install-cert)",
      "Bash(npm publish *)",
      "Bash(git push --force *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(rm -rf *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Read(.env)",
      "Read(**/.env)",
      "Read(**/secrets/**)",
      "Read(**/*.pfx)",
      "Read(**/certs/**)"
    ]
  }
}
