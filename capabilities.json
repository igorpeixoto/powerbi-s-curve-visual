    "dataViewMappings": [
        {
            "conditions": [
                {
                    "category": {
                        "max": 1
                    },
                    "categoryDate": {
                        "max": 0
                    },
                    "series": {
                        "max": 1
                    },
                    "columnValues": {
                        "max": 6
                    },
                    "lineValues": {
                        "max": 6
                    },
                    "tableOnlyValues": {
                        "max": 10
                    },
                    "tooltips": {
                        "max": 10
                    }
                },
                {
                    "category": {
                        "max": 0
                    },
                    "categoryDate": {
                        "max": 1
                    },
                    "series": {
                        "max": 1
                    },
                    "columnValues": {
                        "max": 6
                    },
                    "lineValues": {
                        "max": 6
                    },
                    "tableOnlyValues": {
                        "max": 10
                    },
                    "tooltips": {
                        "max": 10
                    }
                }
            ],
            "categorical": {
                "categories": {
                    "select": [
                        {
                            "bind": {
                                "to": "category"
                            }
                        },
                        {
                            "bind": {
                                "to": "categoryDate"
                            }
                        }
                    ],
                    "dataReductionAlgorithm": {
                        "top": {
                            "count": 1000
                        }
                    }
                },
                "values": {
                    "group": {
                        "by": "series",
                        "select": [
                            {
                                "for": {
                                    "in": "columnValues"
                                }
                            },
                            {
                                "for": {
                                    "in": "lineValues"
                                }
                            },
                            {
                                "for": {
                                    "in": "tableOnlyValues"
                                }
                            },
                            {
                                "for": {
                                    "in": "tooltips"
                                }
                            }
                        ],
                        "dataReductionAlgorithm": {
                            "top": {
                                "count": 30
                            }
                        }
                    }
                }
            }
        }
    ],
    "sorting": {
        "default": {}
    },
    "supportsLandingPage": true,
    "supportsEmptyDataView": true,
    "supportsHighlight": true,
    "supportsMultiVisualSelection": true,
    "supportsKeyboardFocus": true,
    "tooltips": {
        "supportedTypes": {
