# OS & System Junk
.DS_Store
Thumbs.db
desktop.ini
*.tmp
*.log

# Editors
.vscode/
.idea/
*.swp
*~

# Node toolchain
node_modules/
npm-debug.log*
.npm/

# powerbi-visuals-tools generated & build output
# .api/ is the API surface the toolchain writes for the declared apiVersion; dist/ and
# .tmp/ are build output. All three are regenerated by npm install / pbiviz package and
# must never be hand-edited (CLAUDE.md Hard Rule #12).
.api/
.tmp/
dist/
webpack.statistics.*

# The released binary belongs to its tag, not to the working tree (Hard Rule #13):
# .github/workflows/release.yml attaches dist/<name>.pbiviz to the GitHub Release for vX.Y.Z.
*.pbiviz

# Dev certificate material — machine-local, and never shared
*.pfx
*.cer
*.key
certs/

# Claude Code personal overrides
.claude/settings.local.json

# Local working instructions for the rebuild; not part of the published repo
docs/REBUILD_PLAN.md

# Sync conflict copies
*conflicted copy*

# Python bytecode from tools/
__pycache__/

# Power BI Desktop's per-machine state and data cache for the sample report
**/.pbi/localSettings.json
**/.pbi/cache.abf
